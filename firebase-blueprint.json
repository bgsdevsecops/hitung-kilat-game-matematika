{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profil pengguna dan sinkronisasi progres game antar perangkat",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string" },
        "progress": { "type": "object" },
        "stats": { "type": "object" },
        "dailyState": { "type": "object" },
        "dailyActivity": { "type": "object" }
      },
      "required": ["uid"]
    },
    "TimeAttackScore": {
      "title": "TimeAttackScore",
      "description": "Skor tertinggi mode Time Attack pemain untuk papan peringkat global",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "score": { "type": "number" },
        "accuracy": { "type": "number" },
        "streak": { "type": "number" },
        "solvedCount": { "type": "number" },
        "playerFlag": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "score"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Data progres game hanya dapat dibaca dan diubah oleh pemilik akun"
    },
    "/timeAttackLeaderboard/{userId}": {
      "schema": "TimeAttackScore",
      "description": "Papan peringkat skor tertinggi Time Attack dari seluruh pemain"
    }
  }
}

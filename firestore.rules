rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User progress and profile synchronization
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global Time Attack Leaderboard
    match /timeAttackLeaderboard/{userId} {
      // Anyone can view the top scores
      allow read: if true;
      // Authenticated users can write and update their own leaderboard score
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
